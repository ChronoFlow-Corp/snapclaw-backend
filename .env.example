GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
CLAW_CONFIGS=replace-me

# Optional overrides for local dev.
DEV_HOST=localhost
LOG_LEVEL=info
OPENROUTER_API_TOKEN=

# Email (Resend). Leave EMAIL_ENABLED unset/false to disable email entirely.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@send.snapclaw.ru
EMAIL_FROM_NAME=SnapClaw
EMAIL_REPLY_TO_ADDRESS=
# Backend public base URL, used to build one-click unsubscribe links (marketing email).
EMAIL_PUBLIC_BASE_URL=
# Secret used to sign unsubscribe tokens (required when EMAIL_ENABLED=true).
EMAIL_UNSUBSCRIBE_SECRET=
